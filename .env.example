# ──────────────────────────────────────────────────────────────────────
# Reverse Proxy Configuration
# ──────────────────────────────────────────────────────────────────────

# Upstream target URL. If empty/missing, the proxy returns HTTP 204.
# Example:
TARGET=https://api.aa.com

# Comma-separated whitelist paths (exact match).
# If empty/missing → global proxy (ALL requests forwarded to upstream).
# If set          → only listed paths are forwarded; others get 403.
# Example:
PROXY_PATHS=/v1/completion,/v1/chat/completions
